# ─────────────────────────────────────────────────────────────────────────────
# Reverse proxy com HTTPS automático (Let's Encrypt).
#
# O Caddy emite e renova o certificado sozinho — sem certbot, sem cron.
# Requisito: DNS do domínio apontando para o IP do servidor e portas 80/443
# abertas. A 80 precisa ficar aberta mesmo em site só-HTTPS: é por ela que o
# desafio ACME é validado.
# ─────────────────────────────────────────────────────────────────────────────

{
	email {$ACME_EMAIL}
	# Descomente para testar sem gastar a cota de emissão do Let's Encrypt:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip

	# Redireciona www → domínio raiz (canônico para SEO).
	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}
