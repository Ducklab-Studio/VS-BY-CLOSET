# Postgres real (recomendado: Neon, free tier) — a constraint EXCLUDE USING
# gist que impede double-booking só existe de verdade num Postgres real,
# não dá pra simular em SQLite/mock.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

PORT=3333

# Origens que podem chamar esta API a partir do navegador (ver main.ts).
# Sem isto, produção recusa subir.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ──────────────────────────────────────────────────────────────
# Fase 5 — POST /holds
#
# A loja Shopify que toda reserva pertence. Não existe (ainda) nenhuma
# linha real na tabela `stores` — HoldsService cria/atualiza essa linha
# de forma idempotente na hora de criar o primeiro HOLD, usando estes
# dois valores. Sem eles, nenhum HOLD é criado (fail closed).
SHOPIFY_STORE_DOMAIN=sua-loja.myshopify.com
SHOPIFY_STORE_CURRENCY=CLP

# Versão vigente dos termos aceitos ao criar um HOLD — nunca decidida
# pelo cliente. Obrigatória em produção.
TERMS_VERSION=v1

# ──────────────────────────────────────────────────────────────
# Fase 6 — POST /checkout
#
# Storefront API — só cartCreate (nunca Admin API). Mesmo domínio de
# SHOPIFY_STORE_DOMAIN acima; token é o mesmo valor de
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN do apps/marketing (processo
# separado, não compartilha .env).
SHOPIFY_STOREFRONT_TOKEN=

# Duração operacional do bloqueio durante pagamento (não é regra
# comercial/multa — só até quando a peça continua reservada esperando o
# pagamento confirmar). Placeholder conservador sem confirmação do
# Anderson; ver src/checkout/checkout.config.ts.
PAYMENT_WINDOW_MINUTES=30

# ──────────────────────────────────────────────────────────────
# Fase 7 — POST /webhooks/shopify
#
# Client Secret do app "VS BY CLOSET Aluguel DEV" (client_id em
# apps/shopify-app/shopify.app.toml) — a Shopify assina TODO webhook com
# essa chave, nunca com um segredo à parte (confirmado contra
# shopify.dev/docs/apps/build/webhooks/subscribe/https). Pegue o valor
# real no Partner Dashboard → esse app → Client credentials — é o MESMO
# valor que apps/shopify-app usa como SHOPIFY_API_SECRET (nome diferente
# só porque são dois processos com .env separados; o segredo é um só).
# NUNCA gere um valor aleatório aqui — um segredo inventado por nós jamais
# vai bater com a assinatura que a Shopify realmente envia. Sem isto,
# NENHUM webhook é aceito (fail closed em qualquer ambiente, sem fallback
# de dev — diferente de outras variáveis desta lista).
SHOPIFY_CLIENT_SECRET=

# Segredo do binding assinado Order↔Reservation (ver
# src/reservation-binding.ts) — gere um valor aleatório próprio (ex.:
# `openssl rand -hex 32`), NUNCA reaproveite o SHOPIFY_CLIENT_SECRET (são
# segredos de propósitos diferentes: um autentica a Shopify pra nós, o
# outro autentica nossa própria correlação Order↔Reservation).
# Nunca chega ao navegador; sem isto, checkout não é criado (fail closed,
# sem fallback de dev).
RESERVATION_BINDING_SECRET=

# ──────────────────────────────────────────────────────────────
# Fase 8 — POST /admin/reservations/manual, POST /admin/reservations/:id/cancel
#
# Bearer token server-to-server que autentica as chamadas do apps/marketing
# (vitrine + ClosetAdmin) a este backend — nunca chega ao navegador do
# cliente final. A autenticação de PESSOA (nome+telefone+PIN, Fase 9) é
# outra camada, por cima desta; as duas continuam existindo: esta aqui é
# o mínimo real e seguro pedido explicitamente desde a Fase 8, comparado
# em tempo constante no servidor, nunca um header arbitrário tipo
# `x-admin: true`. Gere um valor forte (ex.: `openssl rand -hex 32`),
# NUNCA reaproveite outro segredo desta lista. Sem isto, NENHUM endpoint
# administrativo aceita nada (fail closed em qualquer ambiente, sem
# fallback de dev).
ADMIN_API_TOKEN=

# ──────────────────────────────────────────────────────────────
# Lembrete operacional 48h antes da retirada
#
# Desligado por padrão. Para WhatsApp, use a Cloud API oficial da Meta e um
# TEMPLATE aprovado. Como a mensagem é iniciada pela loja, não usamos texto
# livre fora da janela de atendimento de 24h.
PICKUP_REMINDER_ENABLED=false
PICKUP_REMINDER_CHANNEL=whatsapp
PICKUP_REMINDER_HOUR_SANTIAGO=10
PICKUP_REMINDER_POLL_MINUTES=15

# Meta WhatsApp Cloud API. Nunca commite os valores reais.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PICKUP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# O template configurado acima deve ter 4 parâmetros no BODY, nesta ordem:
# {{1}} nome do cliente
# {{2}} data da retirada
# {{3}} data prevista de devolução
# {{4}} peças da reserva
# Exemplo de texto para aprovação:
# "Olá {{1}}! Sua retirada na VS BY CLOSET está marcada para {{2}}.
# Devolução prevista: {{3}}. Peças: {{4}}."

# Fallback opcional por e-mail. Só é usado se PICKUP_REMINDER_CHANNEL=email.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
REMINDER_FROM_NAME=VS BY CLOSET

# ──────────────────────────────────────────────────────────────
# scripts/seed-admin.ts — cria/atualiza um AdminUser do ClosetAdmin
# (Fase 9) a partir de variáveis de ambiente, nunca hardcoded no script.
# Só usadas na hora de rodar o script manualmente (não são lidas pela
# API em si) — não precisam estar no .env persistente; pode exportar na
# própria linha de comando. NUNCA coloque um PIN real aqui commitado.
ADMIN_SEED_NAME=
ADMIN_SEED_PHONE=
ADMIN_SEED_PIN=
# Opcional — "ADMIN" ou "STAFF" (default "ADMIN").
ADMIN_SEED_ROLE=
