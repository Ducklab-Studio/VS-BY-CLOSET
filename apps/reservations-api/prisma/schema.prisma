// Fonte central de verdade das reservas.
//
// `daterange` (tipo nativo do Postgres) não tem representação no DSL do
// Prisma, então `ReservationItem.blockedRange` é `Unsupported("daterange")`
// — o Prisma Client sabe que ela existe mas não constrói query normal em
// cima dela. Toda leitura/escrita de reservation_items passa por SQL cru
// ($queryRaw/$executeRaw). É o preço de usar a garantia mais forte que
// existe (a constraint EXCLUDE do banco), em troca de não confiar em lock
// de aplicação.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReservationStatus {
  // `pending` permanece legado da Fase 1. `completed` agora marca a
  // higienização concluída e a liberação operacional da unidade.
  pending
  completed

  // `confirmed`/`cancelled` NÃO são legado — achado da auditoria da
  // Fase 7: estavam listados como legado nos comentários da Fase 4
  // porque nenhuma fase anterior escrevia neles ainda (a Fase 6 parava
  // em pending_payment). A Fase 7 é a primeira a escrevê-los de
  // verdade: `confirmed` quando o webhook confirma pagamento,
  // `cancelled` quando a Shopify informa cancelamento antes da
  // retirada. Corrigido aqui pra o comentário não continuar enganando.
  confirmed
  cancelled

  // Ciclo de vida real, a partir da Fase 4/5.
  hold
  pending_payment
  preparing
  ready_for_pickup
  picked_up
  returned
  cleaning
  expired
  problem

  /// Achado real (não planejado) ao testar late payment: `problem`
  /// genérico está em OCCUPYING_RESERVATION_STATUSES (correto pros
  /// outros casos — ex.: refund em reserva confirmed continua
  /// bloqueando a unidade). Mas conflito de late payment é o OPOSTO —
  /// a capacidade já foi pra outra reserva — e usar `problem` ali
  /// colidia de verdade com a EXCLUDE constraint contra a reserva que
  /// realmente tem a unidade (rodei o teste, não deduzi em tese). Este
  /// status é deliberadamente EXCLUÍDO de OCCUPYING_RESERVATION_STATUSES.
  late_payment_conflict

  @@map("reservation_status")
}

/// Estado da criação do carrinho Shopify pra uma Reservation — ver o
/// comentário em Reservation.checkoutState. `none` é o estado inicial de
/// todo HOLD (nenhuma tentativa de checkout ainda); `failed` é
/// re-tentável (POST /checkout de novo tenta criar um cart novo).
enum CheckoutState {
  none
  creating
  ready
  failed

  @@map("checkout_state")
}

enum WebhookStatus {
  processed
  failed
  ignored

  @@map("webhook_status")
}

/// Fase 9 — papel do funcionário no ClosetAdmin. RBAC sempre validado
/// server-side (guard), nunca por esconder botão no frontend.
enum AdminRole {
  /// Proprietário — único, acima de ADMIN. Gerencia funcionários
  /// (criar/autorizar/bloquear/reativar/remover) e permissões por
  /// módulo; ignora `moduleAccess` (acesso total sempre); único papel
  /// que enxerga a auditoria privada (ações críticas + do
  /// proprietário/perfil técnico).
  SUPER_ADMIN
  ADMIN
  STAFF

  @@map("admin_role")
}

/// Sistema de autorização de funcionários — permissões por módulo
/// operacional. SUPER_ADMIN nunca consulta isto (acesso total by
/// design); controla só ADMIN/STAFF ("funcionários").
enum AdminModule {
  RESERVATIONS
  CALENDAR
  PIECES
  RULES
  REPORTS
  AUDIT
  /// Valle Pass — produto totalmente separado do fluxo de aluguel
  /// (vale-presente/crédito de compra). Concedido explicitamente, nunca
  /// herdado automaticamente por quem já tinha os outros módulos.
  VALLE_PASS

  @@map("admin_module")
}

/// Fase 9 — login simples (nome + telefone + PIN). Nome NUNCA é fator de
/// segurança (só identificação); `phone` (normalizado antes de gravar e
/// antes de comparar) é a chave real de busca; `pinHash` é o segredo de
/// verdade — nunca gravado em texto puro, nunca devolvido ao frontend.
model AdminUser {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  phone     String    @unique
  pinHash   String    @map("pin_hash")
  role      AdminRole
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Marca o perfil técnico (identificado pelo id real da conta, nunca
  /// por nome/telefone hardcoded em código). Acesso normal ao painel
  /// (mesmos módulos de um ADMIN), mas login/logout não são auditados e
  /// suas ações somem da auditoria visível a funcionários — só o
  /// SUPER_ADMIN as vê (writeAdminAuditEvent computa `isPrivileged`
  /// automaticamente a partir deste campo).
  isTechnical Boolean @default(false) @map("is_technical")
  /// Vazio por padrão — SUPER_ADMIN precisa conceder módulo por módulo
  /// ao criar um funcionário. Ignorado inteiramente para SUPER_ADMIN
  /// (sempre acesso total) e para isTechnical=true (idem).
  moduleAccess AdminModule[] @default([]) @map("module_access")
  /// "Remover funcionário" nunca é DELETE — preserva a referência em
  /// auditoria/reservas manuais já registradas. Distinto de "bloquear"
  /// (active=false, sempre reversível): removido também fica
  /// active=false, mas carrega quando/por quem foi removido.
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  removedBy String?   @map("removed_by") @db.Uuid

  sessions           AdminSession[]
  auditEvents        AdminAuditEvent[]
  createdBlocks      OperationalBlock[]

  @@map("admin_users")
}

/// Fase 9 — sessão real, revogável (logout de verdade, não só apagar
/// cookie no navegador). `id` é uma identidade própria (UUID), separada
/// do segredo — `tokenHash` é o HASH do token que vai no cookie HttpOnly
/// (mesmo padrão de `hold_token_hash`: o valor puro nunca toca o banco).
model AdminSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@map("admin_sessions")
}

/// Fase 9 — auditoria de ações do painel que NÃO pertencem naturalmente
/// a uma Reservation (login, logout, regra alterada, peça ativada/
/// desativada, bloqueio criado/removido). Ações que JÁ são de uma
/// Reservation (criar/cancelar manual, override) continuam em
/// `ReservationEvent` — ganham só `adminUserId` no `detail`, sem
/// duplicar a responsabilidade dessa tabela aqui.
model AdminAuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Nullable: uma tentativa de login que falhou (usuário não
  /// encontrado/inativo/PIN errado) não tem um AdminUser real pra
  /// vincular, mas ainda precisa ser auditável.
  adminUserId   String?  @map("admin_user_id") @db.Uuid
  /// Denormalizado de propósito — o nome no momento da ação, pra o
  /// registro de auditoria continuar legível mesmo se o AdminUser for
  /// renomeado ou desativado depois.
  adminUserName String?  @map("admin_user_name")
  action        String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id")
  before        Json?
  after         Json?
  detail        Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Computados automaticamente em writeAdminAuditEvent — nunca passados
  /// por quem chama. `isCritical`: a ação é alteração/cancelamento/
  /// permissões/exclusão (lista fixa em admin-audit.ts). `isPrivileged`:
  /// o autor era SUPER_ADMIN ou isTechnical=true NO MOMENTO da ação.
  /// Controlam só VISIBILIDADE pra funcionários (AdminAuditService) —
  /// nunca escondem nem apagam a linha em si; SUPER_ADMIN sempre vê tudo.
  isCritical    Boolean  @default(false) @map("is_critical")
  isPrivileged  Boolean  @default(false) @map("is_privileged")

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
  @@index([isPrivileged])
  @@index([isCritical])
  @@map("admin_audit_events")
}

/// Fase 9 — escopo de um bloqueio operacional: a loja inteira (fechada,
/// manutenção, evento) ou uma peça específica (fora de operação).
enum BlockScope {
  STORE_WIDE
  UNIT

  @@map("block_scope")
}

/// Fase 9 — bloqueio real, precisa afetar disponibilidade/calendário/
/// reserva manual/fluxo público (nunca só visual). `rentalUnitId` nulo
/// quando `scope = STORE_WIDE`. `removedAt` marca quando foi levantado;
/// QUEM levantou fica em AdminAuditEvent (BLOCK_REMOVED), não duplicado
/// aqui como uma segunda FK.
model OperationalBlock {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope                BlockScope
  rentalUnitId         String?    @map("rental_unit_id") @db.Uuid
  startDate            DateTime   @map("start_date") @db.Date
  endDate              DateTime   @map("end_date") @db.Date
  reason               String
  createdByAdminUserId String     @map("created_by_admin_user_id") @db.Uuid
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  removedAt            DateTime?  @map("removed_at") @db.Timestamptz(6)

  rentalUnit RentalUnit? @relation(fields: [rentalUnitId], references: [id])
  createdBy  AdminUser   @relation(fields: [createdByAdminUserId], references: [id])

  @@index([rentalUnitId])
  @@index([startDate, endDate])
  @@map("operational_blocks")
}

/// Fase 8 — de onde a reserva veio. `online` é o default (cobre toda
/// reserva já existente, feita pelo checkout público das Fases 4-7);
/// `manual_admin` é criada pela equipe via POST /admin/reservations/manual,
/// nunca passa por HOLD/checkout Shopify.
enum ReservationSource {
  online
  manual_admin

  @@map("reservation_source")
}

/// Cada loja Shopify.
model Store {
  id            String   @id
  shopifyDomain String   @unique @map("shopify_domain")
  currency      String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reservations  Reservation[]
  webhookEvents WebhookEvent[]

  @@map("stores")
}

/// Uma peça física — a unidade que de fato é emprestada. `id` (UUID) é a
/// identidade real; `code` é o identificador legível (ex.: VS-SOB-001),
/// único mas não é mais a chave primária.
///
/// `shopifyProductId`/`shopifyVariantId` não são UNIQUE de propósito: uma
/// variante Shopify pode ter várias RentalUnits (mesmo modelo, várias
/// peças físicas) — é o padrão "Sobretudo Preto → VS-SOB-001, VS-SOB-002".
model RentalUnit {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique

  name String
  /// Legado — caução hoje é fixa (R$1000/pessoa, presencial), não por
  /// peça. Mantido, não removido, até confirmar se algum dia varia.
  depositAmount Decimal? @map("deposit_amount") @db.Decimal(10, 2)

  shopifyProductId String? @map("shopify_product_id")
  shopifyVariantId String? @map("shopify_variant_id")
  shopifySku       String? @map("shopify_sku")

  /// Acessório = false. Sobretudo/jaqueta/bota = true (padrão). Checado
  /// no servidor antes de qualquer reserva — nunca confia no que o
  /// frontend mandou.
  reservableOnline           Boolean @default(true) @map("reservable_online")
  countsTowardRentalDuration Boolean @default(true) @map("counts_toward_rental_duration")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reservationItems  ReservationItem[]
  operationalBlocks OperationalBlock[]

  @@index([shopifyVariantId])
  @@index([active])
  @@map("rental_units")
}

/// A reserva. `pickupDate`/`returnDate` são datas civis (sem hora) — ver
/// o motor de regras em src/rental-rules. O status da reserva representa
/// o agregado operacional; cada `ReservationItem` carrega sua própria
/// etapa de devolução/higienização.
model Reservation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  status ReservationStatus @default(hold)

  pickupDate DateTime? @map("pickup_date") @db.Date
  returnDate DateTime? @map("return_date") @db.Date
  calculatedReturnDate DateTime? @map("calculated_return_date") @db.Date
  rentalDurationDays Int? @map("rental_duration_days")

  /// Só tem valor enquanto status = hold. Não é o que garante a trava —
  /// isso é a EXCLUDE constraint. É usado pra leitura/UI.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  originStoreId String @map("origin_store_id")
  /// Opcionais: um HOLD ainda não tem pedido Shopify — só ganha os dois
  /// quando vira pending_payment.
  shopifyOrderId  String? @map("shopify_order_id")
  shopifyOrderGid String? @map("shopify_order_gid")
  customerEmail   String? @map("customer_email")

  /// Fase 8 — de onde esta reserva veio. DEFAULT online cobre toda linha
  /// existente sem backfill (ver migration 20260904200000).
  source ReservationSource @default(online)
  /// Só preenchidos em reserva manual (`source = manual_admin`) — o
  /// checkout público nunca coleta nome/telefone, o cliente nem se
  /// autentica. Nulos em toda reserva online.
  customerName  String? @map("customer_name")
  customerPhone String? @map("customer_phone")
  /// Observação interna da equipe — nunca exposta em endpoint público
  /// (GET /reservations/:id/status não a devolve).
  internalNote  String? @map("internal_note")

  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  termsVersion    String?   @map("terms_version")

  /// SHA-256 do capability token devolvido ao cliente na criação do HOLD
  /// — nunca o token em si (ver src/holds/hold-token.ts). Prova de posse
  /// pra qualquer operação sensível sobre este HOLD (Fase 6: iniciar
  /// checkout). `reservationId` sozinho nunca é suficiente.
  holdTokenHash String? @map("hold_token_hash")

  /// Estado da criação do carrinho Shopify — modelado explicitamente
  /// porque não existe transação ACID entre Postgres e Shopify (ver
  /// CheckoutService, seção "chamada externa + transação" do relatório
  /// da Fase 6). `creating` é o estado transitório enquanto a chamada à
  /// Storefront API está em voo; `updatedAt` (abaixo) é usado pra
  /// detectar um `creating` "preso" (processo caiu no meio) e permitir
  /// nova tentativa depois de um tempo curto, sem precisar de coluna
  /// extra só pra isso.
  checkoutState      CheckoutState @default(none) @map("checkout_state")
  /// UNIQUE: um cart Shopify não pode pertencer a duas Reservations —
  /// nulo é permitido múltiplas vezes (Postgres trata cada NULL como
  /// distinto), só o VALOR, quando existe, precisa ser único.
  shopifyCartId       String?      @unique @map("shopify_cart_id")
  /// Endurecimento pedido antes de continuar a Fase 7 — nonce público
  /// (não é segredo) que entra na assinatura HMAC do binding
  /// Order↔Reservation (ver src/reservation-binding.ts). Gravado só o
  /// id, NUNCA a assinatura (recomputada sempre no servidor a partir
  /// deste id + itens reais + datas — nunca confiada de um valor
  /// armazenado) e NUNCA o segredo HMAC.
  reservationBindingId String?     @unique @map("reservation_binding_id")
  checkoutUrl         String?      @map("checkout_url")
  checkoutCreatedAt   DateTime?    @map("checkout_created_at") @db.Timestamptz(6)
  /// Fim da janela de pagamento (PAYMENT_WINDOW_MINUTES após o checkout
  /// ficar pronto) — política explícita da Fase 6, não uma regra
  /// silenciosa. Ver seção 10/11 do relatório: um checkout Shopify pode
  /// continuar "pagável" depois disso — é o que a Fase 7 (late payment)
  /// precisa tratar.
  paymentExpiresAt    DateTime?    @map("payment_expires_at") @db.Timestamptz(6)

  /// Só gravado quando o webhook confirma pagamento de verdade (Fase 7)
  /// — nunca por redirect do cliente, nunca pelo frontend. Ver
  /// WebhooksService.
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  // Legado (Fase 1) — não usado por reserva nova. Mantido até uma
  // migration de limpeza futura, depois que nada mais ler/escrever aqui.
  sku       String?                    @map("sku")
  dateRange Unsupported("daterange")?  @map("date_range")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// "Limpar históricos" — soft delete puro, nunca DELETE físico. Só
  /// tira a reserva da listagem operacional padrão; nada aqui apaga ou
  /// altera status, itens, pagamentos, webhooks ou eventos. Reversível
  /// (ver ReservationArchiveService.restore). `archivedBy` é o
  /// AdminUser.id de quem arquivou — sem relação FK de propósito (mesmo
  /// padrão frouxo de AdminAuditEvent.adminUserId): a reserva arquivada
  /// não pode virar inconsistente se o AdminUser for removido no futuro.
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedBy     String?   @map("archived_by") @db.Uuid
  archiveReason  String?   @map("archive_reason")

  originStore Store             @relation(fields: [originStoreId], references: [id])
  items       ReservationItem[]
  idempotencyKeys       HoldIdempotencyKey[]
  manualIdempotencyKeys ManualReservationIdempotencyKey[]
  webhookEvents         WebhookEvent[]
  events                ReservationEvent[]

  @@unique([originStoreId, shopifyOrderId])
  @@index([status])
  @@index([archivedAt])
  @@map("reservations")
}

/// Garante que POST /holds seja seguro contra double-click / retry de rede
/// / reenvio do frontend: a MESMA `key` (header `Idempotency-Key`, escolhida
/// pelo cliente) sempre devolve o mesmo HOLD, nunca cria dois. `key` é a
/// própria chave primária — não um índice auxiliar — porque é o Postgres
/// (via violação de PK) que arbitra a corrida quando duas requisições com a
/// mesma chave chegam ao mesmo tempo (ver HoldsService), não um lock de
/// aplicação. `requestHash` existe pra detectar reuso indevido: mesma chave
/// com payload DIFERENTE é um erro do chamador, não um replay legítimo.
model HoldIdempotencyKey {
  key           String   @id
  requestHash   String   @map("request_hash")
  reservationId String   @map("reservation_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("hold_idempotency_keys")
}

/// Fase 8 — mesmo mecanismo técnico de HoldIdempotencyKey (a PK arbitra
/// a corrida, não um lock de aplicação), mas em tabela PRÓPRIA: pedido
/// explícito pra não misturar o espaço de chaves do HOLD público com o
/// da criação manual — uma Idempotency-Key do painel administrativo
/// nunca deve poder colidir com uma do carrinho público.
model ManualReservationIdempotencyKey {
  key           String   @id
  requestHash   String   @map("request_hash")
  reservationId String   @map("reservation_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("manual_reservation_idempotency_keys")
}

/// Uma peça física dentro de uma reserva — é aqui que a trava
/// anti-double-booking vive de verdade (ver migration
/// 20260903120100_rental_units_and_items pela EXCLUDE constraint).
model ReservationItem {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId String @map("reservation_id") @db.Uuid
  rentalUnitId  String @map("rental_unit_id") @db.Uuid

  status ReservationStatus @map("status")

  /// Janela de ocupação já com preparo+higienização embutidos —
  /// calculada e gravada na criação, não derivada depois.
  blockedRange Unsupported("daterange") @map("blocked_range")

  /// Recebimento e higienização são por peça física. `completed` libera
  /// esta unidade; `returned` e `cleaning` continuam bloqueando mesmo
  /// depois da janela planejada em `blocked_range`.
  returnedAt DateTime? @map("returned_at") @db.Timestamptz(6)
  returnedBy String? @map("returned_by") @db.Uuid
  cleaningStartedAt DateTime? @map("cleaning_started_at") @db.Timestamptz(6)
  cleaningStartedBy String? @map("cleaning_started_by") @db.Uuid
  cleaningCompletedAt DateTime? @map("cleaning_completed_at") @db.Timestamptz(6)
  cleaningCompletedBy String? @map("cleaning_completed_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reservation Reservation @relation(fields: [reservationId], references: [id])
  rentalUnit  RentalUnit  @relation(fields: [rentalUnitId], references: [id])

  @@index([reservationId])
  @@index([rentalUnitId, status])
  @@map("reservation_items")
}

/// Configuração das regras de aluguel — singleton (uma linha só, id
/// fixo "default"). Espelha src/rental-rules/rental-rule-config.ts;
/// quando a API de disponibilidade lê daqui em vez do fallback local, o
/// Anderson passa a poder ajustar os números sem precisar de mim.
model RentalRuleConfig {
  id String @id @default("default")

  minAdvanceDays Int @default(15) @map("min_advance_days")
  prepDays       Int @default(3) @map("prep_days")
  cleaningDays   Int @default(2) @map("cleaning_days")

  blackoutStart String @default("06-01") @map("blackout_start")
  blackoutEnd   String @default("09-30") @map("blackout_end")

  maxPieces Int @default(6) @map("max_pieces")

  /// [{"upTo":2,"days":2},{"upTo":4,"days":3},{"upTo":6,"days":4}]
  piecesToDaysTable Json @map("pieces_to_days_table")

  timezone String @default("America/Santiago")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("rental_rule_config")
}

/// Todo webhook recebido, com o id que a Shopify manda (X-Shopify-Webhook-Id)
/// — garante idempotência: a UNIQUE em `shopifyWebhookId` é quem arbitra
/// duas entregas simultâneas do mesmo evento (mesmo padrão de
/// hold_idempotency_keys/reservations_shopify_cart_id_key — Postgres
/// árbitro, não lock de aplicação). Ver WebhooksService pra semântica
/// exata de status: `processed` (mudança real aplicada, ou duplicata
/// legítima), `ignored` (verificado e válido, mas não-acionável de
/// forma permanente — ex.: sem reservation_id — reprocessar não muda
/// nada), `failed` (erro inesperado/transitório — RETENTÁVEL; ver
/// item 15 da Fase 7: a transação de negócio nunca commita junto com um
/// status `processed` quando algo dá errado no meio).
///
/// `reservationId`/`orderId` são REDUNDANTES de propósito — o vínculo
/// "de verdade" mora em `Reservation.shopifyOrderId`; aqui é só pra
/// auditoria/consulta rápida sem precisar abrir o payload JSON.
model WebhookEvent {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopifyWebhookId String        @unique @map("shopify_webhook_id")
  storeId          String        @map("store_id")
  topic            String
  payload          Json
  status           WebhookStatus
  errorMessage     String?       @map("error_message")
  /// Quantas vezes este MESMO shopifyWebhookId chegou aqui (Shopify
  /// reenvia em retry, ou duas entregas quase simultâneas) — 1 na
  /// primeira vez, incrementado a cada nova chegada (mesmo quando
  /// idempotentemente ignorada).
  attemptCount     Int           @default(1) @map("attempt_count")
  reservationId    String?       @map("reservation_id") @db.Uuid
  orderId          String?       @map("order_id")
  processedAt      DateTime      @default(now()) @map("processed_at") @db.Timestamptz(6)

  store       Store        @relation(fields: [storeId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  events      ReservationEvent[]

  @@index([storeId, topic])
  @@index([reservationId])
  @@map("webhook_events")
}

/// Trilha de auditoria de negócio — item 14 da Fase 7. Deliberadamente
/// uma tabela SEPARADA de WebhookEvent (não duplica a responsabilidade
/// dela): WebhookEvent é "o que a Shopify entregou, uma vez, deduplicado
/// por shopifyWebhookId" (granularidade = 1 entrega); ReservationEvent é
/// "o que aconteceu com a reserva" (granularidade = 1 acontecimento de
/// negócio — um ÚNICO webhook de orders/paid pode gerar vários:
/// ORDER_LINKED + PAYMENT_CONFIRMED + RESERVATION_STATUS_CHANGED juntos,
/// e um evento como WEBHOOK_INVALID_SIGNATURE pode nem ter Reservation
/// nenhuma pra vincular). `reservationId` nullable de propósito por
/// causa desse último caso.
model ReservationEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId  String?  @map("reservation_id") @db.Uuid
  webhookEventId String?  @map("webhook_event_id") @db.Uuid
  type           String
  /// Sempre sanitizado antes de gravar (nunca token/secret/payload
  /// financeiro cru) — ver WebhooksService.
  detail         Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reservation  Reservation?  @relation(fields: [reservationId], references: [id])
  webhookEvent WebhookEvent? @relation(fields: [webhookEventId], references: [id])

  @@index([reservationId])
  @@index([type])
  @@map("reservation_events")
}

/// Valle Pass — vale-presente/crédito de compra vendido pelo checkout
/// oficial da Shopify (Mercado Pago já configurado), TOTALMENTE
/// separado do fluxo de aluguel: nunca lê/grava RentalUnit,
/// Reservation, disponibilidade ou HOLD. Continua vendável mesmo com
/// agendamentos de aluguel bloqueados, porque não depende de nada
/// dessas tabelas.
enum ValePassStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED

  @@map("vale_pass_status")
}

/// A "campanha": configura valor/validade/quantidade de UM produto
/// Valle Pass já criado manualmente na Shopify (mesmo padrão de
/// RentalUnit.shopifyVariantId — este código nunca cria produto na
/// Shopify, só referencia uma variante que já existe). "Encerrar" a
/// campanha é `active=false`: nunca DELETE, nunca apaga os vales já
/// vendidos.
model ValePassCampaign {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  /// Em centavos — nunca float, evita erro de arredondamento monetário.
  amountCents      Int      @map("amount_cents")
  /// Dias de validade A PARTIR DA COMPRA (não uma data fixa da
  /// campanha) — cada vale grava seu próprio `expiresAt` no momento em
  /// que é emitido.
  validityDays     Int      @map("validity_days")
  /// Nulo = sem limite. Comparado contra `count(vouchers)` no momento
  /// da emissão (dentro da mesma transação do webhook).
  quantityLimit    Int?     @map("quantity_limit")
  shopifyVariantId String   @unique @map("shopify_variant_id")
  active           Boolean  @default(true)
  /// Sem relação FK de propósito (mesmo padrão de
  /// Reservation.archivedBy/AdminUser.removedBy) — nunca trava se o
  /// AdminUser autor for removido/excluído permanentemente no futuro.
  createdBy        String?  @db.Uuid @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vouchers ValePass[]

  @@map("vale_pass_campaigns")
}

/// Um vale individual — nasce automaticamente quando `orders/paid`
/// confirma um pedido com line item de uma campanha ativa (ver
/// ValePassWebhookService), nunca criado manualmente com valor livre.
model ValePass {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Código único de resgate (ex.: VALLE-AB12-CD34) — gerado por
  /// generateValePassCode(), nunca sequencial/previsível.
  code              String         @unique
  campaignId        String         @map("campaign_id") @db.Uuid
  /// Snapshot do valor da campanha NO MOMENTO da compra — nunca muda
  /// mesmo que a campanha seja editada depois.
  amountCents       Int            @map("amount_cents")
  status            ValePassStatus @default(ACTIVE)
  purchasedAt       DateTime       @map("purchased_at") @db.Timestamptz(6)
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(6)
  customerName      String?        @map("customer_name")
  customerPhone     String?        @map("customer_phone")
  customerEmail     String?        @map("customer_email")
  shopifyOrderId    String?        @map("shopify_order_id")
  shopifyOrderGid   String?        @map("shopify_order_gid")
  /// Número legível do pedido (ex.: "#1002") — só pra exibição no
  /// ClosetAdmin, nunca usado pra correlação/lógica.
  shopifyOrderName  String?        @map("shopify_order_name")
  usedAt            DateTime?      @map("used_at") @db.Timestamptz(6)
  usedBy            String?        @db.Uuid @map("used_by")
  cancelledAt       DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy       String?        @db.Uuid @map("cancelled_by")
  cancelReason      String?        @map("cancel_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign ValePassCampaign @relation(fields: [campaignId], references: [id])
  events   ValePassEvent[]

  @@index([campaignId])
  @@index([status])
  @@index([shopifyOrderId])
  @@map("vale_passes")
}

/// Trilha de eventos por vale (criado, usado, cancelado, expirado) —
/// mesmo espírito de ReservationEvent, mas num domínio totalmente
/// separado (nunca mistura com auditoria/eventos de reserva).
model ValePassEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  valePassId String   @map("vale_pass_id") @db.Uuid
  type       String
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  valePass ValePass @relation(fields: [valePassId], references: [id])

  @@index([valePassId])
  @@map("vale_pass_events")
}
