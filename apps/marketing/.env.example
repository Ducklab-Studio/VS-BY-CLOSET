# ──────────────────────────────────────────────────────────────
# Storefront API — catálogo E carrinho
#
# Shopify Admin → Configurações → Apps e canais de vendas →
# Desenvolver apps → Criar um app → Configurar Storefront API
#
# Escopos necessários:
#   unauthenticated_read_product_listings
#   unauthenticated_read_product_inventory
#   unauthenticated_write_checkouts   (carrinho)
#   unauthenticated_read_checkouts
#
# Este token é público por design da Shopify: ele só lê catálogo e mexe
# no carrinho de quem o possui. Por isso pode ir num NEXT_PUBLIC_. O que
# NUNCA pode aparecer aqui: token de Admin API, segredo de webhook,
# string de conexão do banco.
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=sua-loja.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# URL da loja Shopify. Sobrou para o que a Shopify de fato hospeda:
# conta do cliente e rastreio de pedido. Produto, calendário e carrinho
# são deste site — o cliente só sai daqui no checkout.
NEXT_PUBLIC_SHOPIFY_STORE_URL=https://sua-loja.myshopify.com

# ──────────────────────────────────────────────────────────────
# Disponibilidade (banco central) — GET /availability do reservations-api
#
# Vazio, ou a API fora do ar: o calendário mostra "não foi possível
# consultar a disponibilidade" e o botão de reservar fica desabilitado.
# Desde a Fase 4, NUNCA mostra data fictícia — o fallback de demonstração
# que existia aqui foi removido de propósito (fail closed).
#
# Local: http://localhost:3333/availability (reservations-api rodando)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_AVAILABILITY_URL=

# GET /rental-plan/duration — mesma função (durationForPieces) usada pela
# disponibilidade, só sem data. Usado pelo resumo do carrinho pra nunca
# ter uma tabela peças→dias duplicada no frontend. Vazio ou fora do ar:
# o carrinho mostra "não foi possível calcular o período", nunca inventa.
#
# Local: http://localhost:3333/rental-plan/duration
NEXT_PUBLIC_RENTAL_PLAN_URL=

# ──────────────────────────────────────────────────────────────
# Fase 6 — POST /holds e POST /checkout do reservations-api
#
# O carrinho NÃO cria mais o checkout direto na Shopify: o botão
# "Finalizar reserva" primeiro cria um HOLD (bloqueio real de 30min no
# Postgres), depois pede ao backend pra abrir o carrinho Shopify — o
# backend controla o vínculo Reservation ↔ Cart, nunca o navegador
# sozinho. Vazio, ou a API fora do ar: o botão mostra erro, nunca cai de
# volta pro fluxo antigo.
#
# Local: http://localhost:3333/holds / http://localhost:3333/checkout
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_HOLDS_URL=
NEXT_PUBLIC_CHECKOUT_URL=

# GET /reservations/:id/status — a página pós-checkout (Fase 7) consulta
# isto pra saber o status REAL (nunca assume "confirmada" só porque o
# cliente voltou do checkout). Local: http://localhost:3333/reservations
NEXT_PUBLIC_RESERVATIONS_URL=

# WhatsApp do atendimento — usado quando reservar não é possível
# (dentro dos 15 dias ou na alta temporada). Só números, com país.
NEXT_PUBLIC_WHATSAPP=

# ──────────────────────────────────────────────────────────────
# Valle Pass — vale-presente/crédito de compra, produto Shopify normal
# que nunca entra no fluxo de aluguel (calendário/disponibilidade/HOLD).
# Aceita ID numérico ou GID da Shopify. Vazio usa o produto/variante
# reais já cadastrados (ver src/lib/vale-pass-product.ts).
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_VALE_PASS_PRODUCT_ID=
NEXT_PUBLIC_VALE_PASS_VARIANT_ID=

# ──────────────────────────────────────────────────────────────
# Site
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────
# Fase 9 — ClosetAdmin (/closetadmin). SEM NEXT_PUBLIC_: estas duas
# variáveis são lidas SÓ em código server-only (src/lib/admin-api.ts,
# marcado com o pacote `server-only`) — o navegador nunca as recebe. O
# mesmo ADMIN_API_TOKEN da Fase 8, gerado no reservations-api; aqui é só
# a cópia que este servidor usa pra falar com ele server-to-server.
#
# Local: http://localhost:3333 (reservations-api rodando)
# ──────────────────────────────────────────────────────────────
RESERVATIONS_API_ADMIN_URL=
ADMIN_API_TOKEN=
