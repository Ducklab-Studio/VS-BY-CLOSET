# ──────────────────────────────────────────────────────────────
# Storefront API (leitura pública de catálogo)
# Shopify Admin → Apps → Desenvolver apps → criar app → Storefront API
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=sua-loja.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# URL pública da loja (tema Liquid) — para onde o botão "Reservar" aponta.
# Decisão provisória: subdomínio dedicado ao Shopify. Ver README para
# a alternativa de mesmo-domínio via proxy, ainda não decidida.
NEXT_PUBLIC_SHOPIFY_STORE_URL=https://loja.vsbycloset.com.br

# ──────────────────────────────────────────────────────────────
# Site
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
