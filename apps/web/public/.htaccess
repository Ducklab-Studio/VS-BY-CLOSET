# ─────────────────────────────────────────────────────────────────────────────
# Configuração Apache para hospedagem estática (Hostinger compartilhada, cPanel).
#
# Só tem efeito no build estático (`pnpm build:static`), onde não há servidor
# Node para enviar cabeçalhos. Na Vercel e no Docker este arquivo é ignorado —
# lá os headers vêm do next.config.mjs.
#
# ATENÇÃO: a lista de cabeçalhos abaixo espelha a do next.config.mjs. Ao mudar
# um, mude o outro.
# ─────────────────────────────────────────────────────────────────────────────

<IfModule mod_headers.c>
  # Libera os domínios do Booqable. Sem isto o navegador bloqueia o script da
  # integração e o site fica sem catálogo — primeiro lugar a conferir se os
  # produtos não aparecerem.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://booqable.com https://*.booqable.com https://*.booqablecdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://booqable.com https://*.booqable.com https://*.booqablecdn.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://booqable.com https://*.booqable.com https://*.booqablecdn.com; frame-src 'self' https://booqable.com https://*.booqable.com https://*.booqablecdn.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://booqable.com https://*.booqable.com; upgrade-insecure-requests"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── HTTPS obrigatório ────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redireciona www → domínio raiz (canônico para SEO).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ── Cache ────────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Assets do Next carregam hash no nome: podem ser cacheados para sempre.
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|webp|avif|png|jpg|jpeg|gif|ico)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>

  # HTML não pode ser cacheado: é como um deploy novo chega ao visitante.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compressão ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ── Página 404 do Next ───────────────────────────────────────────────────────
ErrorDocument 404 /404.html
