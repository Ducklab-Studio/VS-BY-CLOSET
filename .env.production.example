# ═════════════════════════════════════════════════════════════════════════════
# PRODUÇÃO — copie para `.env` no servidor e preencha.
#
#   cp .env.production.example .env && nano .env
#
# Este arquivo nunca vai para o git.
# ═════════════════════════════════════════════════════════════════════════════

# ── Domínio e SSL ────────────────────────────────────────────────────────────
# O DNS (registro A) já precisa apontar para o IP deste servidor.
DOMAIN=valleshowroom.com.br
ACME_EMAIL=voce@valleshowroom.com.br

# ── Booqable ─────────────────────────────────────────────────────────────────
# Identificador da conta: a parte antes de `.booqable.com` na URL da sua loja.
# Settings → Online Bookings → Website integration.
#
# Atenção: esta variável é embutida no bundle em tempo de build. Alterá-la
# exige `docker compose build`, não apenas restart.
BOOQABLE_COMPANY=

# Preencha apenas se o snippet do painel apontar para uma URL diferente do
# padrão https://<conta>.booqable.com/embed.js
BOOQABLE_SCRIPT_URL=
