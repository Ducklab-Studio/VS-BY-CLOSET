# ═════════════════════════════════════════════════════════════════════════════
# PRODUÇÃO — copie para `.env` no servidor e preencha.
#
#   cp .env.production.example .env && nano .env
#
# Este arquivo NUNCA vai para o git. A API se recusa a subir se algum segredo
# ainda estiver com valor de exemplo.
# ═════════════════════════════════════════════════════════════════════════════

# ── Domínio e SSL ────────────────────────────────────────────────────────────
# DNS (A/AAAA) já precisa apontar para o IP deste servidor.
DOMAIN=loja.com.br
ACME_EMAIL=voce@loja.com.br

# ── Banco de dados ───────────────────────────────────────────────────────────
POSTGRES_USER=loja
POSTGRES_DB=loja
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Segredos JWT ─────────────────────────────────────────────────────────────
# Gere CADA UM separadamente (precisam ser diferentes entre si):
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900          # 15 min
JWT_REFRESH_TTL=604800      # 7 dias

# ── Rate limit ───────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# ── Migrações ────────────────────────────────────────────────────────────────
RUN_MIGRATIONS=true
# Só na primeira subida, para criar o usuário admin e o catálogo de exemplo.
RUN_SEED=false

# ── Object storage para imagens (Cloudflare R2 ou AWS S3) ────────────────────
# Sem isso o upload fica desabilitado e o admin aceita apenas URL colada.
#
# Cloudflare R2 (recomendado — sem custo de saída de dados):
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_URL=https://cdn.loja.com.br     (domínio ligado ao bucket)
#
# AWS S3:
#   S3_ENDPOINT=                              (deixe vazio)
#   S3_REGION=sa-east-1
#   S3_PUBLIC_URL=https://<bucket>.s3.sa-east-1.amazonaws.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Pagamentos (fase de integração) ──────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── E-mail transacional ──────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Loja <no-reply@loja.com.br>"
