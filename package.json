{
  "name": "valles-closet",
  "version": "0.3.0",
  "private": true,
  "description": "Aluguel de roupa de neve — Next.js (vitrine) + Shopify/PRP (produto, carrinho, checkout)",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @valle/marketing dev",
    "build": "pnpm --filter @valle/marketing build",
    "start": "pnpm --filter @valle/marketing start",
    "theme:dev": "cd theme && shopify theme dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,liquid}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
