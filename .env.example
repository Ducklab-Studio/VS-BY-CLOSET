# ═════════════════════════════════════════════════════════════════════════════
# Desenvolvimento — copie para `.env`
#
#   cp .env.example .env
# ═════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# Booqable — a plataforma de locação por trás do site
# ──────────────────────────────────────────────────────────────
# Identificador da sua conta: a parte antes de `.booqable.com` na URL da loja.
# Encontre em: Settings → Online Bookings → Website integration.
#
# Sem isso o site funciona normalmente, mas os componentes de catálogo,
# datas e carrinho aparecem como placeholders.
NEXT_PUBLIC_BOOQABLE_COMPANY=

# Só preencha se o snippet do painel apontar para uma URL diferente do padrão
# https://<sua-conta>.booqable.com/embed.js
NEXT_PUBLIC_BOOQABLE_SCRIPT_URL=

# ──────────────────────────────────────────────────────────────
# Site
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
