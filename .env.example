# ──────────────────────────────────────────────────────────────
# Banco de dados (PostgreSQL)
# ──────────────────────────────────────────────────────────────
POSTGRES_USER=loja
POSTGRES_PASSWORD=loja_dev_password
POSTGRES_DB=loja
POSTGRES_PORT=5432
DATABASE_URL="postgresql://loja:loja_dev_password@localhost:5432/loja?schema=public"

# ──────────────────────────────────────────────────────────────
# API (NestJS)
# ──────────────────────────────────────────────────────────────
API_PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Em produção o Next faz proxy de /api/v1 e o CORS fica vazio.
# Em dev o front chama a API direto, então CORS_ORIGIN acima vale.
SAME_ORIGIN_PROXY=false

# Cookie do refresh token. Em produção: lax + secure=true (mesmo domínio),
# ou none + secure=true se a API ficar em domínio separado.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.loja.com.br      # só para compartilhar entre subdomínios

# Ligue quando houver proxy reverso na frente (produção).
TRUST_PROXY=false

# Rate limit distribuído. Sem isso o contador é por instância.
# REDIS_URL=redis://localhost:6379

# Auth (gere segredos fortes: `openssl rand -base64 48`)
JWT_ACCESS_SECRET=troque-este-segredo-de-access-token
JWT_ACCESS_TTL=900            # 15 min em segundos
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-token
JWT_REFRESH_TTL=604800        # 7 dias em segundos

# Rate limit
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# ──────────────────────────────────────────────────────────────
# Frontend (Next.js)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL interna da API, usada no SSR e no proxy de /api/v1.
# Em produção com Docker: http://api:3333
API_INTERNAL_URL=http://localhost:3333

# ──────────────────────────────────────────────────────────────
# Object storage para upload de imagens (Cloudflare R2 / AWS S3)
# Sem isso o admin aceita apenas URL de imagem colada.
# ──────────────────────────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ──────────────────────────────────────────────────────────────
# Pagamentos (preencher na fase de integração)
# ──────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────
# E-mail (recuperação de senha / notificações)
# ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Loja <no-reply@sualoja.com.br>"
