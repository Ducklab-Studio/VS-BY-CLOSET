{% comment %}
  Neve ambiente — equivalente Liquid do Snowfall.tsx da vitrine Next.js.
  Mesmos 28 flocos, mesmos parâmetros: os dois sistemas devem parecer o
  mesmo site, mesmo rodando em stacks diferentes. Valores fixos (não
  {{ 'now' | date: '%N' }} nem nada variável) — puro CSS, sem JS.
{% endcomment %}
{%- if settings.show_snowfall -%}
  <div class="snowfall" aria-hidden="true">
    {%- assign flakes = '2,4,16,-3,24,0.55|7,3,21,-14,-18,0.4|12,5,14,-8,30,0.6|17,2,24,-2,-12,0.35|22,4,18,-11,20,0.5|27,3,20,-6,-26,0.45|32,6,13,-19,16,0.65|37,2,26,-1,-20,0.3|42,4,17,-9,28,0.55|47,3,22,-15,-14,0.4|52,5,15,-4,22,0.6|57,2,25,-12,-24,0.35|62,4,19,-7,18,0.5|67,3,23,-17,-16,0.42|72,6,14,-5,26,0.62|77,2,27,-20,-22,0.3|4,3,20,-10,20,0.45|84,4,16,-13,-18,0.55|89,5,18,-3,24,0.6|94,2,24,-16,-20,0.35|14,3,21,-6,16,0.4|29,4,17,-18,-28,0.52|44,2,25,-9,18,0.32|59,5,15,-1,-22,0.58|74,3,22,-14,26,0.4|91,4,19,-8,-16,0.5|97,2,26,-4,20,0.3|65,6,13,-21,-24,0.65' | split: '|' -%}
    {%- for flake in flakes -%}
      {%- assign f = flake | split: ',' -%}
      <span
        class="snowfall__flake"
        style="left:{{ f[0] }}%; width:{{ f[1] }}px; height:{{ f[1] }}px; opacity:{{ f[5] }}; animation-duration:{{ f[2] }}s; animation-delay:{{ f[3] }}s; --drift:{{ f[4] }}px;"
      ></span>
    {%- endfor -%}
  </div>
{%- endif -%}
