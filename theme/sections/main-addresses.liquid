<section class="main-addresses page-width" style="padding-block: 3rem;">
  <a href="{{ routes.account_url }}" style="font-size: 0.8rem; color: var(--color-text-muted);">
    &larr; {{ 'customer.account.title' | t }}
  </a>
  <h1 style="font-size: 1.5rem; margin-top: 1rem;">{{ 'customer.addresses.title' | t }}</h1>

  {%- for address in customer.addresses -%}
    <div style="border: 1px solid var(--color-border); padding: 1rem; margin-top: 1rem;">
      {{ address | format_address }}
    </div>
  {%- else -%}
    <p style="color: var(--color-text-muted); margin-top: 1rem;">{{ 'customer.addresses.none' | t }}</p>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Endereços"
}
{% endschema %}
