<section class="main-page page-width" style="max-width: 44rem; padding-block: 3rem;">
  <h1 style="font-size: 1.75rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1.5rem;">
    {{ page.title }}
  </h1>
  <div style="margin-top: 2rem; color: var(--color-text-muted); line-height: 1.7;">
    {{ page.content }}
  </div>
</section>

{% schema %}
{
  "name": "Página"
}
{% endschema %}
