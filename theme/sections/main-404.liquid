<section class="main-404 page-width" style="padding-block: 5rem; text-align: center;">
  <h1 style="font-size: 2rem;">{{ 'sections.404.title' | t }}</h1>
  <p style="color: var(--color-text-muted); margin-top: 1rem;">{{ 'sections.404.text' | t }}</p>
  <a href="{{ routes.root_url }}" class="btn btn--solid" style="margin-top: 2rem; display: inline-flex;">
    {{ 'sections.404.link' | t }}
  </a>
</section>

{% schema %}
{
  "name": "Página não encontrada"
}
{% endschema %}
