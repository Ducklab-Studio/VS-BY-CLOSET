<section class="main-register page-width" style="max-width: 24rem; padding-block: 4rem;">
  <h1 style="font-size: 1.5rem; text-align: center;">{{ 'customer.register.title' | t }}</h1>

  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}

    <label for="RegisterName" style="display: block; margin-top: 1.5rem; font-size: 0.8rem;">
      {{ 'customer.register.name' | t }}
    </label>
    <input type="text" name="customer[first_name]" id="RegisterName" autocomplete="name"
      style="width: 100%; padding: 0.75rem; background: transparent; color: var(--color-text); border: 1px solid var(--color-border); margin-top: 0.5rem;">

    <label for="RegisterEmail" style="display: block; margin-top: 1rem; font-size: 0.8rem;">
      {{ 'customer.register.email' | t }}
    </label>
    <input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required
      style="width: 100%; padding: 0.75rem; background: transparent; color: var(--color-text); border: 1px solid var(--color-border); margin-top: 0.5rem;">

    <label for="RegisterPassword" style="display: block; margin-top: 1rem; font-size: 0.8rem;">
      {{ 'customer.register.password' | t }}
    </label>
    <input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required
      style="width: 100%; padding: 0.75rem; background: transparent; color: var(--color-text); border: 1px solid var(--color-border); margin-top: 0.5rem;">

    <button type="submit" class="btn btn--solid" style="width: 100%; margin-top: 1.5rem;">
      {{ 'customer.register.submit' | t }}
    </button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Cadastro"
}
{% endschema %}
