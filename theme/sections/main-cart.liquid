<section class="main-cart page-width" style="padding-block: 3rem;">
  <h1 style="font-size: 1.75rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1.5rem;">
    {{ 'general.cart.title' | t }}
  </h1>

  {%- if cart.item_count == 0 -%}
    <p style="color: var(--color-text-muted); margin-top: 2rem;">{{ 'general.cart.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn" style="margin-top: 1rem; display: inline-flex;">
      {{ 'general.cart.continue_shopping' | t }}
    </a>
  {%- else -%}
    {%- form 'cart', cart -%}
      <table style="width: 100%; margin-top: 2rem; border-collapse: collapse;">
        <tbody>
          {%- for item in cart.items -%}
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 1rem 0; display: flex; gap: 1rem; align-items: center;">
                {{ item.image | image_url: width: 120 | image_tag: loading: 'lazy' }}
                <div>
                  <p>{{ item.product.title }}</p>
                  {%- if item.variant.title != 'Default Title' -%}
                    <p style="font-size: 0.8rem; color: var(--color-text-muted);">{{ item.variant.title }}</p>
                  {%- endif -%}
                </div>
              </td>
              <td style="text-align: right;">
                <input
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="{{ 'general.cart.quantity' | t }}"
                  style="width: 4rem; background: transparent; color: var(--color-text); border: 1px solid var(--color-border); padding: 0.25rem;"
                >
              </td>
              <td style="text-align: right; padding-left: 1rem;">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem;">
        <p style="font-size: 1.1rem;">{{ 'general.cart.total' | t }}: {{ cart.total_price | money }}</p>
        <button type="submit" name="checkout" class="btn btn--solid">
          {{ 'general.cart.checkout' | t }}
        </button>
      </div>
    {%- endform -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Carrinho"
}
{% endschema %}
