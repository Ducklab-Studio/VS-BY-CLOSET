<footer class="site-footer" style="border-top: 1px solid var(--color-border); margin-top: 4rem;">
  <div class="page-width" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; padding-block: 3rem;">
    <div>
      {{ 'logo-horizontal-marsala.png' | asset_url | image_tag: alt: shop.name, height: 48, style: 'height: 3rem; width: auto; object-fit: contain;' }}
      {%- if section.settings.description != blank -%}
        <p style="color: var(--color-text-muted); font-size: 0.875rem; margin-top: 0.5rem;">
          {{ section.settings.description }}
        </p>
      {%- endif -%}
    </div>

    {%- if section.settings.menu != blank -%}
      <div>
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" style="display: block; font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 0.5rem;">
            {{ link.title }}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div style="border-top: 1px solid var(--color-border); padding-block: 1.5rem;">
    <p class="page-width" style="font-size: 0.7rem; color: var(--color-text-muted); text-align: center;">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'sections.footer.rights_reserved' | t }}
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrição da marca"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}
