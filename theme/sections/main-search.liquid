<section class="main-search page-width" style="padding-block: 3rem;">
  <h1 style="font-size: 1.5rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1.5rem;">
    {{ 'general.search.results_for' | t: terms: search.terms }}
  </h1>

  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.5rem; margin-top: 2rem;">
    {%- for item in search.results -%}
      <a href="{{ item.url }}" style="display: block;">
        {%- if item.featured_media -%}
          {{ item.featured_media | image_url: width: 600 | image_tag: loading: 'lazy' }}
        {%- endif -%}
        <p style="margin-top: 0.75rem; font-size: 0.875rem;">{{ item.title }}</p>
      </a>
    {%- else -%}
      <p style="color: var(--color-text-muted);">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Busca"
}
{% endschema %}
