<section class="main-account page-width" style="padding-block: 3rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border); padding-bottom: 1.5rem;">
    <h1 style="font-size: 1.5rem;">{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a>
  </div>

  <h2 style="font-size: 1rem; margin-top: 2rem;">{{ 'customer.orders.title' | t }}</h2>

  {%- if customer.orders.size == 0 -%}
    <p style="color: var(--color-text-muted); margin-top: 1rem;">{{ 'customer.orders.none' | t }}</p>
  {%- else -%}
    <table style="width: 100%; margin-top: 1rem; border-collapse: collapse;">
      <thead>
        <tr style="border-bottom: 1px solid var(--color-border); text-align: left; font-size: 0.75rem; color: var(--color-text-muted);">
          <th style="padding-bottom: 0.75rem;">{{ 'customer.orders.order_number' | t }}</th>
          <th>{{ 'customer.orders.date' | t }}</th>
          <th>{{ 'customer.orders.payment_status' | t }}</th>
          <th style="text-align: right;">{{ 'customer.orders.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for order in customer.orders -%}
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td style="padding: 0.75rem 0;"><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
            <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
            <td>{{ order.financial_status_label }}</td>
            <td style="text-align: right;">{{ order.total_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  {%- endif -%}

  <h2 style="font-size: 1rem; margin-top: 2.5rem;">{{ 'customer.addresses.title' | t }}</h2>
  <a href="{{ routes.account_addresses_url }}" style="display: inline-block; margin-top: 0.5rem;">
    {{ 'customer.addresses.manage' | t }}
  </a>
</section>

{% schema %}
{
  "name": "Minha conta"
}
{% endschema %}
