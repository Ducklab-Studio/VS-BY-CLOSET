// ═══════════════════════════════════════════════════════════════════════════
//  E-COMMERCE DE ROUPAS — Schema do banco de dados (PostgreSQL + Prisma)
//  Modelo de dados completo cobrindo catálogo, vendas, pagamentos,
//  devoluções, suporte, blog, auditoria e configurações.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── ENUMS ──────────────────────────────────────

enum Role {
  ADMIN // Administrador — acesso total
  MANAGER // Gerente — gestão de catálogo, pedidos, relatórios
  SUPPORT // Atendente — suporte, tickets, pedidos
  CUSTOMER // Cliente
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING_VERIFICATION
}

enum AddressType {
  SHIPPING
  BILLING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum OrderStatus {
  PENDING // Pendente
  IN_ANALYSIS // Em análise
  PAID // Pago
  SEPARATING // Separando
  INVOICED // Nota fiscal emitida
  SHIPPED // Enviado
  OUT_FOR_DELIVERY // Saiu para entrega
  DELIVERED // Entregue
  CANCELED // Cancelado
  REFUNDED // Reembolsado
}

enum PaymentProvider {
  MERCADO_PAGO
  STRIPE
  PIX
  BOLETO
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  DECLINED
  REFUNDED
  CHARGEBACK
  CANCELED
}

enum CouponType {
  PERCENTAGE // Desconto %
  FIXED // Valor fixo
  FREE_SHIPPING // Frete grátis
}

enum ReturnType {
  RETURN // Devolução (reembolso)
  EXCHANGE // Troca
}

enum ReturnStatus {
  REQUESTED // Solicitado pelo cliente
  UNDER_REVIEW // Admin analisando
  APPROVED // Aprovado
  REJECTED // Rejeitado
  LABEL_ISSUED // Etiqueta emitida
  IN_TRANSIT // Em trânsito (cliente enviou)
  RECEIVED // Recebido
  INSPECTING // Em inspeção
  REFUNDED // Reembolsado
  EXCHANGED // Trocado
  CANCELED
}

enum NotificationType {
  ORDER
  PAYMENT
  SHIPPING
  RETURN
  PROMOTION
  SYSTEM
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryMovementType {
  INBOUND // Entrada
  OUTBOUND // Saída (venda)
  RESERVE // Reserva
  RELEASE // Liberação de reserva
  ADJUSTMENT // Ajuste de inventário
  RETURN // Retorno ao estoque
}

enum CashbackStatus {
  PENDING
  AVAILABLE
  USED
  EXPIRED
}

enum AuditAction {
  LOGIN
  LOGOUT
  REGISTER
  PURCHASE
  PAYMENT
  ERROR
  STOCK_CHANGE
  ORDER_CANCEL
  REFUND
  EXCHANGE
  RETURN
  PRODUCT_UPDATE
  PRICE_UPDATE
  PERMISSION_CHANGE
  ACCESS
  SYSTEM_FAILURE
}

// ───────────────────────── USUÁRIOS & AUTENTICAÇÃO ─────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  phone         String?
  cpf           String?    @unique
  passwordHash  String
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  avatarUrl     String?

  addresses        Address[]
  orders           Order[]
  reviews          Review[]
  favorites        Favorite[]
  cart             Cart?
  refreshTokens    RefreshToken[]
  passwordResets   PasswordReset[]
  notifications    Notification[]
  tickets          Ticket[]
  returns          Return[]
  cashbackEntries  CashbackEntry[]
  couponUsages     CouponUsage[]
  auditLogs        AuditLog[]
  blogComments     BlogComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String // hash do refresh token (nunca em texto puro)
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_resets")
}

model Address {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         AddressType @default(SHIPPING)
  recipient    String
  zipCode      String
  street       String
  number       String
  complement   String?
  district     String
  city         String
  state        String
  country      String      @default("BR")
  isDefault    Boolean     @default(false)

  shippingOrders Order[] @relation("OrderShippingAddress")
  billingOrders  Order[] @relation("OrderBillingAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────── CATÁLOGO ─────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  // SEO
  metaTitle       String?
  metaDescription String?
  isActive    Boolean    @default(true)
  position    Int        @default(0)

  products ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  sku         String        @unique
  barcode     String?       @unique
  description String        @db.Text
  material    String?
  weightGrams Int? // peso em gramas (frete)
  // dimensões para cálculo de frete (cm)
  widthCm     Float?
  heightCm    Float?
  lengthCm    Float?
  sizeChart   Json? // tabela de medidas
  status      ProductStatus @default(DRAFT)
  isFeatured  Boolean       @default(false) // destaque
  isNewArrival Boolean      @default(false) // lançamento

  // preços base (variações podem sobrescrever)
  price            Decimal  @db.Decimal(10, 2)
  promoPrice       Decimal? @db.Decimal(10, 2)
  pixDiscountPct   Decimal? @db.Decimal(5, 2) // desconto PIX %
  maxInstallments  Int      @default(1) // parcelamento

  // SEO
  metaTitle       String?
  metaDescription String?

  // métricas (denormalizadas para performance de listagem)
  ratingAvg   Decimal @default(0) @db.Decimal(3, 2)
  ratingCount Int     @default(0)
  soldCount   Int     @default(0)

  brandId    String?
  brand      Brand?            @relation(fields: [brandId], references: [id])
  categories ProductCategory[]
  media      ProductMedia[]
  variants   ProductVariant[]
  reviews    Review[]
  favorites  Favorite[]

  related        ProductRelation[] @relation("ProductRelated")
  relatedBy      ProductRelation[] @relation("ProductRelatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([brandId])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@map("products")
}

// N:N produto <-> categoria
model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

// Produtos relacionados (N:N auto-referência)
model ProductRelation {
  productId String
  relatedId String
  product   Product @relation("ProductRelated", fields: [productId], references: [id], onDelete: Cascade)
  related   Product @relation("ProductRelatedBy", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId])
  @@map("product_relations")
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      MediaType @default(IMAGE)
  url       String
  alt       String?
  position  Int       @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_media")
}

// Variação = combinação cor + tamanho, com SKU/estoque/preço próprios
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String   @unique
  barcode    String?
  color      String?
  colorHex   String?
  size       String?
  price      Decimal? @db.Decimal(10, 2) // sobrescreve preço base se definido
  promoPrice Decimal? @db.Decimal(10, 2)
  imageUrl   String?
  isActive   Boolean  @default(true)

  inventory          Inventory?
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  cartItems          CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

// ──────────────────────────────── ESTOQUE ─────────────────────────────────

model Inventory {
  id           String         @id @default(cuid())
  variantId    String         @unique
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity     Int            @default(0) // disponível físico
  reserved     Int            @default(0) // reservado por pedidos não pagos
  lowStockAt   Int            @default(5) // alerta de estoque baixo
  location     String? // posição no estoque

  updatedAt DateTime @updatedAt

  @@map("inventory")
}

model InventoryMovement {
  id        String                @id @default(cuid())
  variantId String
  variant   ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      InventoryMovementType
  quantity  Int // pode ser negativo
  reason    String?
  orderId   String?
  order     Order?                @relation(fields: [orderId], references: [id])
  userId    String? // responsável (admin) pela movimentação manual

  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([orderId])
  @@map("inventory_movements")
}

// ──────────────────────── CARRINHO & SALVAR P/ DEPOIS ──────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique // null = carrinho anônimo
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique // para visitantes não logados
  couponId  String?
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  items     CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id         String         @id @default(cuid())
  cartId     String
  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int            @default(1)
  savedForLater Boolean     @default(false) // salvar para depois

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ──────────────────────────────── PEDIDOS ─────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  number      String      @unique // número amigável (ex: 2026-000123)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)

  // valores (congelados no momento da compra)
  subtotal       Decimal @db.Decimal(10, 2)
  discountTotal  Decimal @default(0) @db.Decimal(10, 2)
  shippingTotal  Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  shippingAddressId String?
  shippingAddress   Address? @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String?
  billingAddress    Address? @relation("OrderBillingAddress", fields: [billingAddressId], references: [id])

  // entrega
  shippingMethod  String?
  shippingCarrier String? // transportadora
  trackingCode    String?
  estimatedAt     DateTime?

  // nota fiscal
  invoiceNumber String?
  invoiceKey    String? // chave NF-e
  invoiceUrl    String?

  items             OrderItem[]
  payments          Payment[]
  statusHistory     OrderStatusHistory[]
  returns           Return[]
  inventoryMovements InventoryMovement[]
  notifications     Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // snapshot do produto no momento da compra
  productName String
  variantName String?
  sku         String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  total       Decimal @db.Decimal(10, 2)

  returnItems ReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  changedBy String? // userId do responsável (admin/sistema)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

// ─────────────────────────────── PAGAMENTOS ───────────────────────────────

model Payment {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  amount        Decimal         @db.Decimal(10, 2)
  installments  Int             @default(1)
  externalId    String? // id da transação no gateway
  pixQrCode     String?
  pixCopyPaste  String?
  boletoUrl     String?
  boletoBarcode String?
  cardBrand     String?
  cardLast4     String?
  rawPayload    Json? // resposta bruta do gateway (webhook)
  paidAt        DateTime?

  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([externalId])
  @@map("payments")
}

model Refund {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  returnId   String?
  return     Return?  @relation(fields: [returnId], references: [id])
  amount     Decimal  @db.Decimal(10, 2)
  reason     String?
  externalId String?
  processedBy String? // userId do admin
  createdAt  DateTime @default(now())

  @@index([paymentId])
  @@map("refunds")
}

// ──────────────────────────────── CUPONS ──────────────────────────────────

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  description     String?
  type            CouponType
  value           Decimal    @db.Decimal(10, 2) // % ou valor fixo
  minOrderValue   Decimal?   @db.Decimal(10, 2)
  maxUses         Int? // quantidade máxima total
  maxUsesPerUser  Int        @default(1)
  usedCount       Int        @default(0)
  startsAt        DateTime?
  expiresAt       DateTime?
  isActive        Boolean    @default(true)
  // restrições opcionais (categorias/clientes específicos)
  categoryIds     String[]   @default([])
  userIds         String[]   @default([])

  usages CouponUsage[]
  orders Order[]
  carts  Cart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId  String?
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

// ───────────────────── AVALIAÇÕES, FAVORITOS, CASHBACK ─────────────────────

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1..5
  title     String?
  comment   String?      @db.Text
  photos    String[]     @default([])
  status    ReviewStatus @default(PENDING)
  storeReply String?     @db.Text // resposta da loja
  reportedCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([status])
  @@map("reviews")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
}

model CashbackEntry {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  amount    Decimal        @db.Decimal(10, 2)
  status    CashbackStatus @default(PENDING)
  expiresAt DateTime?
  createdAt DateTime       @default(now())

  @@index([userId])
  @@map("cashback_entries")
}

// ─────────────────────── DEVOLUÇÕES, TROCAS, REEMBOLSO ─────────────────────

model Return {
  id        String       @id @default(cuid())
  number    String       @unique
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      ReturnType   @default(RETURN)
  status    ReturnStatus @default(REQUESTED)
  reason    String
  photos    String[]     @default([])
  labelUrl  String? // etiqueta de envio
  resolution String? // descrição da resolução (reembolso/troca)

  items   ReturnItem[]
  history ReturnHistory[]
  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("returns")
}

model ReturnItem {
  id          String    @id @default(cuid())
  returnId    String
  return      Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  reason      String?

  @@index([returnId])
  @@map("return_items")
}

// Histórico completo da devolução (cada mudança registrada)
model ReturnHistory {
  id        String       @id @default(cuid())
  returnId  String
  return    Return       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  status    ReturnStatus
  note      String?
  changedBy String?
  createdAt DateTime     @default(now())

  @@index([returnId])
  @@map("return_history")
}

// ─────────────────────────── NOTIFICAÇÕES ─────────────────────────────────

model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  title   String
  message String
  link    String?
  readAt  DateTime?
  orderId String?
  order   Order?           @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// ──────────────────────────── SUPORTE / TICKETS ───────────────────────────

model Ticket {
  id        String         @id @default(cuid())
  number    String         @unique
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  assignedTo String? // userId do atendente

  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String // userId (cliente ou atendente)
  isStaff   Boolean  @default(false)
  body      String   @db.Text
  attachments String[] @default([])
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

// ──────────────────────────────── BLOG ────────────────────────────────────

model BlogCategory {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]

  createdAt DateTime @default(now())

  @@map("blog_categories")
}

model BlogPost {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String        @db.Text
  coverUrl    String?
  published   Boolean       @default(false)
  publishedAt DateTime?
  authorId    String?
  categoryId  String?
  category    BlogCategory? @relation(fields: [categoryId], references: [id])
  // SEO
  metaTitle       String?
  metaDescription String?

  comments BlogComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("blog_posts")
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  authorName String?
  body      String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([postId])
  @@map("blog_comments")
}

// ───────────────────── NEWSLETTER & CONTATO & SETTINGS ─────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

// Configurações chave-valor da loja (banners, redes, frete, etc.)
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ────────────────────────── AUDITORIA / LOGS ──────────────────────────────

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  userId    String? // responsável (null = sistema/anônimo)
  user      User?       @relation(fields: [userId], references: [id])
  entity    String? // ex: "Product", "Order"
  entityId  String?
  ip        String?
  userAgent String?
  detail    Json? // dados antes/depois, payload, mensagem de erro
  createdAt DateTime    @default(now())

  @@index([action])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
